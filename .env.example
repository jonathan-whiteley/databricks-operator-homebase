# Copy this file to .env and fill in. Required for `make dev`.
# Do NOT commit .env.

# Databricks workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=

# UC scope
LHM_CATALOG=jdub_demo
LHM_SCHEMA=lakehouse_market

# Lakebase (filled in after `databricks bundle deploy` provisions the instance)
LAKEBASE_HOST=
LAKEBASE_DB=homebase
LAKEBASE_USER=
LAKEBASE_PASSWORD=

# Genie space (created manually after first deploy)
GENIE_SPACE_ID=

# Model serving + foundation model
LABOR_ENDPOINT=lhm-labor-recommender
FM_ENDPOINT=databricks-claude-sonnet-4-6
