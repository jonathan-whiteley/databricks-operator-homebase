# Copy this file to .env and fill in. Required for `make dev`.
# Do NOT commit .env.
#
# Production-equivalent values live in app.yaml and are auto-set on the
# deployed App; this file only exists for local dev.

# ---------- Databricks workspace ----------
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=

# ---------- UC scope ----------
LHM_CATALOG=jdub_demo
LHM_SCHEMA=lakehouse_market

# ---------- Lakebase ----------
# Read by config.py with PG* fallbacks. Filled in after the first deploy
# from the workspace UI > App > Resources > Database details.
LAKEBASE_INSTANCE=lakehouse-market-app-db
LAKEBASE_HOST=
LAKEBASE_DB=databricks_postgres
LAKEBASE_USER=
LAKEBASE_PASSWORD=
# Or set the standard Postgres envs:
# PGHOST=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=databricks_postgres

# ---------- Genie space ----------
# Created by notebooks/06_ensure_genie_space.py; setup.sh wires this on the
# deployed app. For local dev, list-spaces in the CLI and pin one here.
GENIE_SPACE_ID=

# ---------- Model serving + foundation model ----------
# In dev-mode DAB targets the serving endpoint gets a `dev_<user>_` prefix;
# in production it's just `lhm-labor-recommender`. setup.sh picks the right
# one based on the deployer's user.
LABOR_ENDPOINT=lhm-labor-recommender
FM_ENDPOINT=databricks-claude-sonnet-4-6

# ---------- Demo data anchor ----------
# Optional. Overrides the dynamic MAX(date) anchor. Leave blank in normal use.
# DEMO_ANCHOR_DATE=2025-10-30
